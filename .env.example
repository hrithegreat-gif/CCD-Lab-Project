# Local runtime configuration; never commit a real .env or secret.
# Environment variables override this file. Default model = CPU object detection.
MODEL_CACHE_DIR=models/cache
MODEL_LOCAL_FILES_ONLY=false
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=16777216
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
MAX_DETECTIONS=100
INFERENCE_THREADS=1
MAX_CONCURRENT_INFERENCES=1
INFERENCE_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO

# Empty API_KEY permits unauthenticated LOCAL development only.
# Cloud deployment must use a nonempty SSM SecureString -> Kubernetes Secret.
API_KEY=
# Byte limit must be >= MAX_IMAGE_BYTES + 1024.
MAX_REQUEST_BYTES=5246976
# Enable to expose liveness while the model loads; readiness stays 503 until warm-up.
BACKGROUND_MODEL_LOAD=false

