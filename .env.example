# Local runtime configuration; never commit a real .env or secret.
# Environment variables override this file. Default model = CPU sentiment only.
MODEL_CACHE_DIR=models/cache
MODEL_LOCAL_FILES_ONLY=false
MAX_INPUT_CHARS=2000
MAX_INPUT_TOKENS=256
INFERENCE_THREADS=1
MAX_CONCURRENT_INFERENCES=2
INFERENCE_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO

# Empty API_KEY permits unauthenticated LOCAL development only.
# Cloud deployment must use a nonempty SSM SecureString -> Kubernetes Secret.
API_KEY=
# Byte limit must be >= MAX_INPUT_CHARS * 12 + 1024.
MAX_REQUEST_BYTES=65536
# Enable to expose liveness while the model loads; readiness stays 503 until warm-up.
BACKGROUND_MODEL_LOAD=false

# Optional adapters: disabled = no optional imports, downloads or provider calls.
# Qwen: dedicated venv with requirements-qwen.txt (do not add baseline HF pins).
# Kitten: requirements-kitten.txt. Combined: Qwen profile + requirements-models.txt.
# Optional profiles need separate real model/resource validation; cloud image is core-only.
ENABLE_QWEN=false
ENABLE_KITTEN=false
# Groq is separately billed and NOT covered by AWS credits.
ENABLE_GROQ=false
ENABLE_GROQ_TRANSCRIPTION=false
GROQ_API_KEY=
# For audio uploads, explicitly increase MAX_REQUEST_BYTES (max 10485760)
# after reading docs/MODEL_EXTENSIONS.md and assessing memory/provider costs.
